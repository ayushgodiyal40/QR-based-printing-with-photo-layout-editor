# ==============================================
# Print Shop Application — Environment Variables
# ==============================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="PrintShop"

# Database (PostgreSQL — use Neon, Supabase, or local PG)
DATABASE_URL=postgresql://user:password@host:5432/printshop

# Authentication
AUTH_SECRET=your-super-secret-key-min-32-chars-change-this

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
MAX_ORDER_SIZE_MB=200

# File Retention (hours)
FILE_RETENTION_HOURS=24

# Admin Setup (used only on first run)
INITIAL_ADMIN_EMAIL=admin@printshop.com
INITIAL_ADMIN_PASSWORD=changeme123
INITIAL_SHOP_NAME="My Print Shop"
