# ==============================================
# Print Shop Application — Environment Variables
# ==============================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="PrintShop"

# Database (PostgreSQL — use Neon, Supabase, or local PG)
DATABASE_URL=postgresql://user:password@host:5432/printshop

# Authentication
AUTH_SECRET=your-super-secret-key-min-32-chars-change-this

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
MAX_ORDER_SIZE_MB=200

# File Retention (hours)
FILE_RETENTION_HOURS=24

# Admin Setup (used only on first run)
INITIAL_ADMIN_EMAIL=admin@printshop.com
INITIAL_ADMIN_PASSWORD=changeme123
INITIAL_SHOP_NAME="My Print Shop"

# ==============================================
# Firebase Authentication Configuration
# ==============================================
# Client Web SDK (Paste from Firebase Console -> Project Settings -> General -> Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Server Admin SDK (Optional: For server-side token verification from Service Account)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
